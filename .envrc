# direnv: activates the project-local ESP-IDF when you cd into this folder,
# so idf.py, esptool.py etc. are available directly. Run "direnv allow" once.

source_env tools/idf/env.sh

if idf_is_installed; then
    if ! source "$IDF_PATH/export.sh" >"$IDF_HOME/.export.log" 2>&1; then
        cat "$IDF_HOME/.export.log" >&2
        log_error "ESP-IDF activation failed. Try: tools/idf/setup.sh --force"
    fi
else
    log_error "ESP-IDF $IDF_VERSION not installed. Run: tools/idf/setup.sh"
fi
